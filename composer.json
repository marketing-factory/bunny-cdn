{
  "name": "mfd/typo3-bunny-cdn",
  "type": "typo3-cms-extension",
  "description": "Bunny CDN cache integration for TYPO3",
  "license": [
    "GPL-2.0-or-later"
  ],
  "authors": [
    {
      "name": "Christian Spoo",
      "role": "Developer",
      "email": "christian.spoo@marketing-factory.de"
    }
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.0",
    "typo3/cms-frontend": "^13.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "typo3/testing-framework": "^8.3",
    "ssch/typo3-rector": "^3.15",
    "typo3/coding-standards": "^0.9.0",
    "phpunit/phpunit": "^11.0"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "bunny_cdn"
    }
  },
  "autoload": {
    "psr-4": {
      "Mfd\\BunnyCdn\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mfd\\BunnyCdn\\Tests\\": "Tests/"
    }
  },
  "scripts": {
    "test:unit": "phpunit -c Build/UnitTests.xml",
    "test:unit:docker": "Build/Scripts/runTests.sh -s unit",
    "cgl": "php-cs-fixer fix",
    "cgl:check": "php-cs-fixer fix --dry-run --diff"
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  }
}
